# ============================================================================
# DATABASE
# ============================================================================
DATABASE_URL=postgresql://saas_user:saas_password@db:5432/saas_db
DB_USER=saas_user
DB_PASSWORD=saas_password
DB_NAME=saas_db

# ============================================================================
# SECURITY
# ============================================================================
# Obligatoria, minimo 32 caracteres. Genera una con:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-random-de-32-caracteres-o-mas

# Correos autorizados como administrador (separados por coma, sin espacios)
ADMIN_EMAILS=tu_correo_real@gmail.com

# ============================================================================
# CORS - dominios permitidos a llamar tu API
# ============================================================================
ALLOWED_ORIGINS=https://ingenieroai.pro,https://www.ingenieroai.pro

# ============================================================================
# PAYPAL
# ============================================================================
PAYPAL_CLIENT_ID=tu_client_id_de_developer.paypal.com
PAYPAL_CLIENT_SECRET=tu_client_secret
PAYPAL_MODE=live
# Necesario para que /api/webhooks/paypal funcione (Dashboard PayPal > Webhooks)
PAYPAL_WEBHOOK_ID=tu_webhook_id

# ============================================================================
# TRANSFERENCIA BANCARIA (Guatemala)
# ============================================================================
BANCO_TITULAR=Willy Enriquez Palacios
BANCO_CUENTA_BAM=pon_aqui_tu_cuenta_bam
BANCO_CUENTA_INDUSTRIAL=pon_aqui_tu_cuenta_industrial

# ============================================================================
# NOTIFICACION WHATSAPP (al confirmarse una venta)
# ============================================================================
# Opcion rapida (no oficial, buena para probar hoy):
CALLMEBOT_APIKEY=

# Opcion oficial recomendada a largo plazo (Meta WhatsApp Business Cloud API):
META_WA_TOKEN=
META_WA_PHONE_ID=

# ============================================================================
# EXTERNAL APIs - EMAIL & SMS (opcional)
# ============================================================================
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ============================================================================
# SHOPIFY / MERCADOLIBRE (opcional, solo si conectas tiendas)
# ============================================================================
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
MERCADOLIBRE_CLIENT_ID=
MERCADOLIBRE_CLIENT_SECRET=

# ============================================================================
# ENVIRONMENT
# ============================================================================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
